{
	"name": "n8n-nodes-tweaktick",
	"version": "0.4.0",
	"description": "n8n nodes for TweakTick: trigger on client feedback, approvals and rounds; reply to, resolve and reopen comments.",
	"license": "MIT",
	"homepage": "https://tweaktick.com",
	"keywords": [
		"n8n-community-node-package",
		"tweaktick",
		"website feedback",
		"client approval"
	],
	"author": {
		"name": "TweakTick",
		"email": "support@tweaktick.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/TweakTick/n8n-nodes-tweaktick.git"
	},
	"bugs": {
		"url": "https://github.com/TweakTick/n8n-nodes-tweaktick/issues",
		"email": "support@tweaktick.com"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TweakTickApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TweakTick/TweakTick.node.js",
			"dist/nodes/TweakTickTrigger/TweakTickTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.53.4",
		"eslint": "9.32.0",
		"n8n-workflow": "2.16.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"pnpm": {
		"onlyBuiltDependencies": []
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
